{
  "name": "gladys-victron-vrm",
  "version": "0.2.0",
  "private": true,
  "description": "External Gladys Assistant integration for Victron Energy installations through the official VRM API: one device per installation (battery, solar, grid, consumption), VRM alarms and battery scene triggers, dashboard widgets. Read only.",
  "homepage": "https://github.com/William-De71/gladys-victron-vrm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-victron-vrm.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "victron",
    "victron-energy",
    "vrm",
    "battery",
    "solar",
    "energy",
    "home-automation"
  ]
}
